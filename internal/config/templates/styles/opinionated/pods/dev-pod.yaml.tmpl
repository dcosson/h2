pod_name: dev-pod-{{ .Var.codename }}

variables:
  codename:
    description: "Code name (sand, sea, leaf, fog, etc.) for identifying this pod"
  num_coders:
    description: "Number of coder agents"
    default: "3"
  working_dir:
    description: "Working directory for the agent"
    default: "."
  profile:
    description: "Account profile to use. Must be configured via h2 profile commands."
    default: "default"
  smart_coder_harness:
    description: "Agent harness for the smart coder: claude_code or codex"
    default: "claude_code"
  smart_coder_model:
    description: "Full model name for the smart coder (e.g. claude-fable-5-1, claude-opus-5-5, gpt-6-sol, gpt-6-astra; gpt-* models need smart_coder_harness=codex)"
    default: "claude-fable-5-1"

# Optional: bridges (reference named bridges from config.yaml)
bridges:
  - bridge: "user-{{ .Var.codename }}" # key in config.yaml's top-level bridges map
    concierge: "concierge-{{ .Var.codename }}"

# Required: agents
#
# Model roster:
#   concierge   -> Claude Opus 5.5
#   smart-coder -> smart_coder_model on smart_coder_harness (default Claude Fable 5.1)
#   coder-1     -> GPT-6 Sol (codex)
#   coder-2     -> Claude Opus 5.5
#   coder-3     -> GPT-6 Sol (codex)
#   reviewer    -> GPT-6 Sol (codex)
agents:
  - name: "concierge-{{ .Var.codename }}"
    role: concierge
    vars:
      profile: {{ .Var.profile }}
      agent_harness: claude_code
      agent_model: claude-opus-5-5

  - name: "smart-coder-{{ .Var.codename }}"
    role: default
    vars:
      profile: {{ .Var.profile }}
      agent_harness: "{{ .Var.smart_coder_harness }}"
      agent_model: "{{ .Var.smart_coder_model }}"

  - name: "coder-{{ add 1 .Index }}-{{ .Var.codename }}"
    role: default
    count: {{ .Var.num_coders }}
    vars: # passed to role template rendering
      profile: {{ .Var.profile }}
      agent_harness: "{{ index (split "codex,claude_code,codex" ",") (mod .Index 3) }}"
      agent_model: "{{ index (split "gpt-6-sol,claude-opus-5-5,gpt-6-sol" ",") (mod .Index 3) }}"
      working_dir: "{{ .Var.working_dir }}"

  - name: "reviewer-{{ .Var.codename }}"
    role: default
    vars:
      profile: {{ .Var.profile }}
      agent_harness: codex
      agent_model: gpt-6-sol
